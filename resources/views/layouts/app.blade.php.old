    @php
        use App\Models\Footer;

        $footer = Footer::getFooter();
        $seo    = $footer->seo_settings ?? [];

        // ── Fallback values — always non-empty, even without Footer SEO config ──
        // Aim for 50-60 chars for title, 110-160 chars for description (Google/FB guidelines)
        $appName = config('app.name');

        $ogTitle = !empty($seo['title'])
            ? $seo['title']
            : $appName . ' — #1 Hit Music Radio, Stream Live 24/7 Free';

        $ogDescription = !empty($seo['description'])
            ? $seo['description']
            : 'Listen to ' . $appName . ' live online — your #1 hit music radio station. Stream the hottest songs, latest pop hits, and non-stop music 24 hours a day, 7 days a week. Totally free.';

        $ogUrl      = url()->current();   // correct on every page, not just '/'
        $ogSiteName = $appName;

        // ── Social sharing image (1200×630) — separate from the small MediaSession artwork ──
        // Priority: (1) Admin-uploaded SEO image, (2) SOCIAL_SHARE_IMAGE banner, (3) default artwork
        if (!empty($seo['image']) && file_exists(public_path($seo['image']))) {
            $ogImagePath = $seo['image'];
        } elseif (env('SOCIAL_SHARE_IMAGE') && file_exists(public_path(env('SOCIAL_SHARE_IMAGE')))) {
            $ogImagePath = env('SOCIAL_SHARE_IMAGE');
        } else {
            $ogImagePath = env('DEFAULT_ARTWORK_PATH', 'images/alexaicon.jpg');
        }

        // Build an absolute URL — some crawlers reject relative paths
        $ogImage = str_starts_with($ogImagePath, 'http')
            ? $ogImagePath
            : rtrim(config('app.url') ?: url('/'), '/') . '/' . ltrim($ogImagePath, '/');

        // Detect image type for og:image:type tag
        $ogImageExt  = strtolower(pathinfo($ogImagePath, PATHINFO_EXTENSION));
        $ogImageType = in_array($ogImageExt, ['png', 'webp']) ? 'image/png' : 'image/jpeg';
    @endphp

    {{-- ── Page Title ── --}}
    <title>{{ $ogTitle }}</title>

    {{-- ── Standard SEO meta ── --}}
    <meta name="description" content="{{ $ogDescription }}">

    {{-- ── Open Graph (Facebook / WhatsApp / iMessage / LinkedIn) ── --}}
    {{-- All tags are always emitted so link previews work even without admin SEO config --}}
    <meta property="og:type"             content="website">
    <meta property="og:site_name"        content="{{ $ogSiteName }}">
    <meta property="og:title"            content="{{ $ogTitle }}">
    <meta property="og:description"      content="{{ $ogDescription }}">
    <meta property="og:url"              content="{{ $ogUrl }}">
    <meta property="og:locale"           content="en_US">
    {{-- og:image:secure_url is required by Facebook for HTTPS pages to display the image --}}
    <meta property="og:image"            content="{{ $ogImage }}">
    <meta property="og:image:secure_url" content="{{ $ogImage }}">
    <meta property="og:image:type"       content="{{ $ogImageType }}">
    <meta property="og:image:width"      content="1200">
    <meta property="og:image:height"     content="630">
    <meta property="og:image:alt"        content="{{ $ogTitle }}">

    {{-- ── Twitter / X Card ── --}}
    <meta name="twitter:card"        content="summary_large_image">
    <meta name="twitter:title"       content="{{ $ogTitle }}">
    <meta name="twitter:description" content="{{ $ogDescription }}">
    <meta name="twitter:image"       content="{{ $ogImage }}">
    <meta name="twitter:image:alt"   content="{{ $ogTitle }}">

